[Unit]
Description=Facilitation — Celery beat (scheduler: 8h room expiry sweep)
After=network.target facilitation-env-fetch.service redis-server.service
Requires=facilitation-env-fetch.service

[Service]
User=django
Group=www-data
UMask=0027
WorkingDirectory=/var/www/django_websites/Facilitation_server
EnvironmentFile=/run/facilitation/.env
ExecStart=/var/www/django_websites/Facilitation_server/.venv/bin/celery -A config beat -l info
# Durcissement (2026-10-09) : pas d'élévation de privilèges, /tmp privé, système en
# lecture seule (/usr, /boot, /etc) — /var/www (pièces, beat) et /run restent inscriptibles.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Restart=always
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
